# Copy this file to .env (same folder as docker-compose.yml) to configure
# optional features for `docker compose up --build`. Docker Compose reads
# a .env file here automatically -- you don't need to `source` it or pass
# anything on the command line.
#
# Everything below is OPTIONAL. Leave it blank/unset and the app runs
# fine without it -- the Google Sign-In button just won't render.

# Google Sign-In (see frontend/.env.example for the non-Docker equivalent).
# Get one at https://console.cloud.google.com/apis/credentials -- Web
# application, Authorized JavaScript origins: http://localhost:5173
GOOGLE_CLIENT_ID=

# Email alerts on new incidents (see README's "Email Alerts" section for
# Gmail App Password setup). Leave blank to skip email entirely.
SMTP_USER=
SMTP_PASSWORD=

# The simulator auto-creates this admin account on first run. Defaults to
# a placeholder @trafficvision.ai address if left blank -- fine unless you
# configure SMTP_* above, in which case that placeholder will bounce on
# every incident report. Set to a real email you control to avoid that.
SIMULATOR_ADMIN_EMAIL=
SIMULATOR_ADMIN_PASSWORD=
