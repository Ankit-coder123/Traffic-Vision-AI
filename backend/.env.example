# Copy this file to .env and adjust values for your local PostgreSQL setup
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trafficvision

# Used to sign JWTs -- falls back to an insecure default if unset, so set
# a real random value here for anything beyond local dev.
JWT_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_IN_PRODUCTION
