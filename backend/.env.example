# Copy this file to .env and adjust values for your local PostgreSQL setup
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trafficvision

# Used to sign JWTs -- falls back to an insecure default if unset, so set
# a real random value here for anything beyond local dev.
JWT_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_IN_PRODUCTION

# Optional -- email alerts when an incident is reported (see README's
# "Email Alerts" section for Gmail App Password setup). Leave blank to
# skip email entirely; incident reporting still works without it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=TrafficVision AI

# Used by simulator.py to auto-create/log-into a bootstrap admin account on
# first run. Defaults to a placeholder @trafficvision.ai address if unset,
# which isn't a real deliverable domain -- harmless as long as SMTP_* above
# stays blank, but if you DO configure email alerts, this placeholder
# account will bounce every time. Set this to a real email you control to
# avoid that (and if the account already exists with the old placeholder
# email, you'll need to update it directly in the database too -- these
# vars only control what simulator.py creates, not existing rows).
SIMULATOR_ADMIN_EMAIL=
SIMULATOR_ADMIN_PASSWORD=
